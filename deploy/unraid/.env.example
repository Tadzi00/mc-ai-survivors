# Copy to /mnt/dockervolumes/mc-ai-survivors/.env (outside the repo copy) and edit.
# Change a value, then Compose Down + Compose Up in the Unraid UI.

STACK_DIR=/mnt/dockervolumes/mc-ai-survivors
TZ=Europe/Warsaw

# Minecraft -----------------------------------------------------------------
MC_VERSION=1.21.4
MC_MEMORY=4G
MC_DIFFICULTY=normal
MC_ENABLE_WHITELIST=true
MC_WHITELIST=
MC_OPS=
# Game port on the LAN (25565 belongs to the Minecraft_Hub mc-router).
MC_PORT_PUBLIC=25566

# REQUIRED: long random string (openssl rand -hex 24). Never published outside the stack.
RCON_PASSWORD=

# LLM: the Unraid "ollama" container (published on the host's port 11434) ------
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- CPU profile (no GPU): ~20-40 s per decision with qwen2.5:3b -----------
SMART_MODEL=qwen2.5:3b
BASIC_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=150000
OLLAMA_CONCURRENCY=1
MAX_BOTS=3
SMART_SLOTS=1
INITIAL_BOTS=2

# --- GPU profile (after installing a GPU, see README.md): ~5 s per decision --
# SMART_MODEL=qwen2.5:7b
# BASIC_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_MS=90000
# MAX_BOTS=8
# SMART_SLOTS=2

# Paid providers (only if config.yaml tiers use them):
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

LOG_LEVEL=info
