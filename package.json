{
  "name": "mc-ai-survivors",
  "version": "0.1.0",
  "description": "LLM-driven Minecraft bots that try to survive a harsh, seasonal world. Population grows only when they build shelter.",
  "type": "module",
  "license": "MIT",
  "author": "Tadzi00",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "minecraft-data": "^3.83.0",
    "mineflayer": "^4.25.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "rcon-client": "^4.2.5",
    "vec3": "^0.1.10",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
