# Copy to .env and edit. Used by docker-compose.yml (and read by config.yaml via ${VAR}).

# Minecraft server version (Paper). Bump to upgrade, e.g. 1.21.5 - see README "Upgrading".
MC_VERSION=1.21.4
MC_MEMORY=4G
MC_DIFFICULTY=normal
# Whitelist is strongly recommended in offline mode. Bots are whitelisted automatically via RCON.
MC_ENABLE_WHITELIST=true
# Your own Minecraft name(s) so you can join to watch (comma separated). Also see MC_OPS.
MC_WHITELIST=
MC_OPS=
# Interface to publish the game port on (127.0.0.1 = only this machine).
MC_BIND=0.0.0.0

# REQUIRED: long random string. RCON gives full console access.
RCON_PASSWORD=change-me-to-a-long-random-string

# LLM backends ------------------------------------------------------------
# Ollama: local container (docker compose --profile ollama) or a remote server.
OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_MAX_LOADED_MODELS=1

# Paid providers (only needed if config.yaml tiers use them):
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

LOG_LEVEL=info
